{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aagent.local/protocol/workflow/1.3/schema.json",
  "title": "AAgent Workflow 1.3",
  "type": "object",
  "required": ["schema_version", "name", "input_ports", "output_ports", "nodes", "connections"],
  "properties": {
    "schema_version": { "const": "1.3" },
    "name": { "type": "string" },
    "description": { "type": "string" },
    "input_ports": { "$ref": "#/$defs/ports" },
    "output_ports": { "$ref": "#/$defs/ports" },
    "workflow_nodes": { "type": "array", "items": { "$ref": "#/$defs/dependency" } },
    "remote_tools": { "type": "array", "items": { "$ref": "#/$defs/dependency" } },
    "nodes": { "type": "array", "items": { "$ref": "#/$defs/node" } },
    "connections": { "type": "array", "items": { "$ref": "#/$defs/connection" } }
  },
  "$defs": {
    "port": {
      "type": "object",
      "required": ["name", "type"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "type": { "enum": ["content", "message", "event", "list-content", "list-message", "list-event", "map-content"] }
      },
      "additionalProperties": false
    },
    "ports": { "type": "array", "items": { "$ref": "#/$defs/port" } },
    "dependency": {
      "type": "object",
      "required": ["name", "input_ports", "output_ports"],
      "properties": { "name": { "type": "string", "minLength": 1 }, "input_ports": { "$ref": "#/$defs/ports" }, "output_ports": { "$ref": "#/$defs/ports" } },
      "additionalProperties": false
    },
    "node": {
      "type": "object",
      "required": ["id", "type"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "type": { "enum": ["input", "output", "router", "construct_message", "construct_content", "construct_map_content", "map_content_get", "split_event", "construct_event", "publish_event", "deserialize_json", "construct_list", "list_append", "foreach", "history", "llm", "local_tool", "remote_sync_tool", "remote_async_tool", "context_create", "context_read", "context_write", "session_create", "session_read", "session_write", "workflow"] },
        "name": { "type": "string" }, "x": { "type": "number" }, "y": { "type": "number" }, "arguments": { "type": "object" },
        "workflowPorts": { "type": "array", "items": { "type": "object", "required": ["id", "name", "type"], "properties": { "id": { "type": "string", "minLength": 1 }, "name": { "type": "string", "minLength": 1 }, "type": { "$ref": "#/$defs/port/properties/type" } }, "additionalProperties": false } },
        "dataInputPorts": { "type": "array", "items": { "type": "string" } }, "input_ports": { "$ref": "#/$defs/ports" }, "output_ports": { "$ref": "#/$defs/ports" }
      },
      "additionalProperties": false
    },
    "connection": {
      "type": "object",
      "required": ["fromId", "fromPortId", "toId", "toPortId", "type"],
      "properties": { "id": { "type": "string" }, "fromId": { "type": "string", "minLength": 1 }, "fromPortId": { "type": "string", "minLength": 1 }, "toId": { "type": "string", "minLength": 1 }, "toPortId": { "type": "string", "minLength": 1 }, "type": { "enum": ["control", "content", "message", "event", "list-content", "list-message", "list-event", "map-content"] } },
      "additionalProperties": false
    }
  }
}