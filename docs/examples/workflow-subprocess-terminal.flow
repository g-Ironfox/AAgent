{
  "schema_version": "2.0",
  "description": "在父终端输入 JSON 参数，调用独立子流程，再将返回的问候语输出到父终端；每次运行处理一条消息。",
  "input_ports": [],
  "output_ports": [
    {
      "name": "reply",
      "type": "content"
    },
    {
      "name": "child_result_json",
      "type": "content"
    }
  ],
  "nodes": [
    {
      "id": "input",
      "type": "input",
      "name": "开始",
      "x": 40,
      "y": 100,
      "workflowPorts": []
    },
    {
      "id": "prompt",
      "type": "construct_content",
      "name": "输入提示",
      "x": 320,
      "y": 100,
      "arguments": {
        "append_items": [
          {
            "type": "fixed",
            "value": "请输入参数 JSON，例如 {\"name\":\"小明\"}。"
          }
        ]
      }
    },
    {
      "id": "show-prompt",
      "type": "output_to_terminal",
      "name": "打印提示",
      "x": 600,
      "y": 100
    },
    {
      "id": "read-input",
      "type": "read_terminal_queue",
      "name": "读取终端消息缓冲区",
      "x": 880,
      "y": 440
    },
    {
      "id": "last-input",
      "type": "list_get",
      "name": "取最后一条消息",
      "x": 600,
      "y": 440,
      "arguments": {
        "value_type": "list-content",
        "index_source": "fixed",
        "index": -1
      }
    },
    {
      "id": "child-file",
      "type": "construct_content",
      "name": "子流程文件名",
      "x": 320,
      "y": 440,
      "arguments": {
        "append_items": [
          {
            "type": "fixed",
            "value": "workflow-subprocess-child.flow"
          }
        ]
      }
    },
    {
      "id": "call-child",
      "type": "spawn_and_wait_subprocess",
      "name": "调用子流程",
      "x": 40,
      "y": 440,
      "arguments": {}
    },
    {
      "id": "parse-result",
      "type": "deserialize_json",
      "name": "读取 reply",
      "x": 40,
      "y": 780,
      "arguments": {
        "outputs": [
          {
            "key": "reply",
            "type": "content"
          }
        ]
      }
    },
    {
      "id": "show-reply",
      "type": "output_to_terminal",
      "name": "打印返回结果",
      "x": 320,
      "y": 780
    },
    {
      "id": "output",
      "type": "output",
      "name": "结束",
      "x": 600,
      "y": 780,
      "workflowPorts": [
        {
          "id": "workflow:reply",
          "name": "reply",
          "type": "content"
        },
        {
          "id": "workflow:child_result_json",
          "name": "child_result_json",
          "type": "content"
        }
      ]
    }
  ],
  "connections": [
    {
      "fromId": "input",
      "fromPortId": "control-out",
      "toId": "prompt",
      "toPortId": "control-in",
      "type": "control"
    },
    {
      "fromId": "prompt",
      "fromPortId": "control-out",
      "toId": "show-prompt",
      "toPortId": "control-in",
      "type": "control"
    },
    {
      "fromId": "show-prompt",
      "fromPortId": "control-out",
      "toId": "read-input",
      "toPortId": "control-in",
      "type": "control"
    },
    {
      "fromId": "read-input",
      "fromPortId": "control-out",
      "toId": "last-input",
      "toPortId": "control-in",
      "type": "control"
    },
    {
      "fromId": "last-input",
      "fromPortId": "control-out",
      "toId": "child-file",
      "toPortId": "control-in",
      "type": "control"
    },
    {
      "fromId": "child-file",
      "fromPortId": "control-out",
      "toId": "call-child",
      "toPortId": "control-in",
      "type": "control"
    },
    {
      "fromId": "call-child",
      "fromPortId": "control-out",
      "toId": "parse-result",
      "toPortId": "control-in",
      "type": "control"
    },
    {
      "fromId": "parse-result",
      "fromPortId": "control-out",
      "toId": "show-reply",
      "toPortId": "control-in",
      "type": "control"
    },
    {
      "fromId": "show-reply",
      "fromPortId": "control-out",
      "toId": "output",
      "toPortId": "control-in",
      "type": "control"
    },
    {
      "fromId": "prompt",
      "fromPortId": "content-out",
      "toId": "show-prompt",
      "toPortId": "content-in",
      "type": "content"
    },
    {
      "fromId": "read-input",
      "fromPortId": "list-out",
      "toId": "last-input",
      "toPortId": "list-in",
      "type": "list-content"
    },
    {
      "fromId": "last-input",
      "fromPortId": "item-out",
      "toId": "call-child",
      "toPortId": "arguments-json",
      "type": "content"
    },
    {
      "fromId": "child-file",
      "fromPortId": "content-out",
      "toId": "call-child",
      "toPortId": "workflow-file",
      "type": "content"
    },
    {
      "fromId": "call-child",
      "fromPortId": "result-json",
      "toId": "parse-result",
      "toPortId": "content-in",
      "type": "content"
    },
    {
      "fromId": "parse-result",
      "fromPortId": "reply",
      "toId": "show-reply",
      "toPortId": "content-in",
      "type": "content"
    },
    {
      "fromId": "parse-result",
      "fromPortId": "reply",
      "toId": "output",
      "toPortId": "workflow:reply",
      "type": "content"
    },
    {
      "fromId": "call-child",
      "fromPortId": "result-json",
      "toId": "output",
      "toPortId": "workflow:child_result_json",
      "type": "content"
    }
  ]
}
