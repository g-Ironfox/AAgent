      "type": "control"
    },
    {
      "fromId": "wait_for_human",
      "fromPortId": "control-out",
      "toId": "read_human",
      "toPortId": "control-in",
      "type": "control"
    },
    {
      "fromId": "read_human",
      "fromPortId": "control-out",
      "toId": "latest_human",
      "toPortId": "control-in",
      "type": "control"
    },
    {
      "fromId": "latest_human",
      "fromPortId": "control-out",
      "toId": "done_gate",
