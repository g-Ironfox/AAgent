{
  "schema_version": "2.0",
  "description": "Human-supervised ReAct loop. The model proposes one action, a person performs or rejects it and returns an observation, and DONE ends the run.",
  "input_ports": [
    {
      "name": "task",
      "type": "content"
    }
  ],
  "output_ports": [],
  "metadata": {
    "structs": [],
    "tools": [],
    "functions": [
      {
        "id": "react_turn",
        "name": "ReAct turn with human review",
        "input_ports": [
          {
            "name": "history_id",
            "type": "content"
          },
          {
            "name": "tokens_id",
            "type": "content"
          }
        ],
        "output_ports": []
      }
    ]
  },
  "nodes": [
    {
      "id": "in",
      "type": "input",
      "name": "Input",
      "workflowPorts": [
        {
          "id": "workflow:task",
          "name": "task",
          "type": "content"
        }
      ],
      "x": 80,
      "y": 100
    },
    {
      "id": "system_prompt",
      "type": "construct_content",
      "name": "System prompt",
      "arguments": {
        "append_items": [
          {
            "type": "fixed",
            "value": "You are a ReAct assistant working under human supervision. For each turn, briefly state your reasoning and propose exactly one concrete action. Do not claim that an action was executed. The human will perform, reject, or modify it and send the observation. When the human sends DONE, treat your current proposal as the final answer and end the run."
          }
        ]
      },
      "dataInputPorts": [],
      "x": 330,
      "y": 100
    },
    {
      "id": "system",
      "type": "construct_message",
      "name": "System instruction",
      "arguments": {
        "role": "system"
      },
      "x": 580,
      "y": 100
    },
    {
      "id": "task_message",
      "type": "construct_message",
      "name": "Task message",
      "arguments": {
        "role": "user"
      },
      "x": 830,
      "y": 100
    },
    {
      "id": "initial_history",
      "type": "construct_list",
      "name": "Initial history",
      "arguments": {
        "item_type": "content",
        "initial_value_count": 2
      },
      "dataInputPorts": [
        "content-in-0",
        "content-in-1"
      ],
      "x": 1080,
      "y": 100
    },
    {
      "id": "create_history",
      "type": "context_create",
      "name": "Create history",
      "arguments": {
        "value_type": "list-content"
      },
      "x": 1330,
      "y": 100
    },
    {
      "id": "start_token",
      "type": "construct_content",
      "name": "Start token",
      "arguments": {
        "append_items": [
          {
            "type": "fixed",
            "value": "start"
          }
        ]
      },
      "dataInputPorts": [],
      "x": 1580,
      "y": 100
    },
    {
      "id": "initial_token_list",
      "type": "construct_list",
      "name": "Initial turn tokens",
      "arguments": {
        "item_type": "content",
        "initial_value_count": 1
      },
      "dataInputPorts": [
        "content-in-0"
      ],
      "x": 1830,
      "y": 100
    },
    {
      "id": "create_turn_tokens",
      "type": "context_create",
      "name": "Create turn tokens",
      "arguments": {
        "value_type": "list-content"
      },
      "x": 2080,
      "y": 100
    },
    {
      "id": "turn_gate",
      "type": "while_pop",
      "name": "Next ReAct turn",
      "arguments": {
        "value_type": "list-content",
        "context_id_source": "port",
        "position": "end"
      },
      "x": 2330,
      "y": 100
    },
    {
      "id": "call_turn",
      "type": "function_call",
      "name": "Run one ReAct turn",
      "arguments": {
        "function_id": "react_turn"
      },
      "x": 2580,
      "y": 100
    },
    {
      "id": "out",
      "type": "output",
      "name": "Completed",
      "workflowPorts": [],
      "x": 2830,
      "y": 100
    },
    {
      "id": "turn_in",
      "type": "function_input",
      "name": "Turn input",
      "function_id": "react_turn",
      "x": 80,
      "y": 500
    },
    {
      "id": "read_for_llm",
      "type": "context_read",
      "name": "Read history",
      "arguments": {
        "value_type": "list-content",
        "context_id_source": "port"
      },
      "x": 330,
      "y": 500
    },
    {
      "id": "llm",
      "type": "llm",
      "name": "Reason and propose",
      "arguments": {
        "model": "REPLACE_WITH_MODEL_ID",
        "think": true
      },
      "x": 580,
      "y": 500
    },
    {
      "id": "assistant_message",
      "type": "construct_message",
      "name": "Store assistant turn",
      "arguments": {
        "role": "assistant"
      },
      "x": 830,
      "y": 500
    },
    {
      "id": "read_before_assistant",
      "type": "context_read",
      "name": "Read before append",
      "arguments": {
        "value_type": "list-content",
        "context_id_source": "port"
      },
      "x": 1080,
      "y": 500
    },
    {
      "id": "append_assistant",
      "type": "list_append",
      "name": "Append assistant turn",
      "arguments": {
        "item_type": "content",
        "position": "end"
      },
      "x": 1330,
      "y": 500
    },
    {
      "id": "save_assistant",
      "type": "context_write",
      "name": "Save assistant turn",
      "arguments": {
        "value_type": "list-content",
        "context_id_source": "port"
      },
      "x": 1580,
      "y": 500
    },
    {
      "id": "show_proposal",
      "type": "output_to_terminal",
      "name": "Show proposal",
      "x": 1830,
      "y": 500
    },
    {
      "id": "wait_for_human",
      "type": "wait_terminal_event",
      "name": "Wait for human",
      "x": 2080,
      "y": 500
    },
    {
      "id": "read_human",
      "type": "read_terminal_input",
      "name": "Read human response",
      "x": 2330,
      "y": 500
    },
    {
      "id": "latest_human",
      "type": "list_get",
      "name": "Latest response",
      "arguments": {
        "value_type": "list-content",
        "index_source": "fixed",
        "index": -1
      },
      "x": 2580,
      "y": 500
    },
    {
      "id": "done_gate",
      "type": "router",
      "name": "Finish?",
      "arguments": {
        "branches": [
          {
            "id": "done",
            "name": "DONE"
          }
        ]
      },
      "x": 2830,
      "y": 500
    },
    {
      "id": "turn_done",
      "type": "function_output",
      "name": "Done: leave queue empty",
      "function_id": "react_turn",
      "x": 2830,
      "y": 800
    },
    {
      "id": "observation_message",
      "type": "construct_message",
      "name": "Store human observation",
      "arguments": {
        "role": "user"
      },
      "x": 3330,
      "y": 500
    },
    {
      "id": "read_before_observation",
      "type": "context_read",
      "name": "Read before observation",
      "arguments": {
        "value_type": "list-content",
        "context_id_source": "port"
      },
      "x": 3580,
      "y": 500
    },
    {
      "id": "append_observation",
      "type": "list_append",
      "name": "Append human observation",
      "arguments": {
        "item_type": "content",
        "position": "end"
      },
      "x": 3830,
      "y": 500
    },
    {
      "id": "save_observation",
      "type": "context_write",
      "name": "Save human observation",
      "arguments": {
        "value_type": "list-content",
        "context_id_source": "port"
      },
      "x": 4080,
      "y": 500
    },
    {
      "id": "read_turn_tokens",
      "type": "context_read",
      "name": "Read turn tokens",
      "arguments": {
        "value_type": "list-content",
        "context_id_source": "port"
      },
      "x": 4330,
      "y": 500
    },
    {
      "id": "append_turn_token",
      "type": "list_append",
      "name": "Queue next turn",
      "arguments": {
        "item_type": "content",
        "position": "end"
      },
      "x": 4580,
      "y": 500
    },
    {
      "id": "save_turn_tokens",
      "type": "context_write",
      "name": "Save turn token",
      "arguments": {
        "value_type": "list-content",
        "context_id_source": "port"
      },
      "x": 4830,
      "y": 500
    },
    {
      "id": "turn_continue",
      "type": "function_output",
      "name": "Continue: next turn queued",
      "function_id": "react_turn",
      "x": 5080,
      "y": 500
    }
  ],
  "connections": [
    {
      "fromId": "in",
      "fromPortId": "control-out",
      "toId": "system_prompt",
      "toPortId": "control-in",
      "type": "control"
    },
    {
      "fromId": "system_prompt",
      "fromPortId": "control-out",
      "toId": "system",
      "toPortId": "control-in",
      "type": "control"
    },
    {
      "fromId": "system",
      "fromPortId": "control-out",
      "toId": "task_message",
      "toPortId": "control-in",
      "type": "control"
    },
    {
      "fromId": "task_message",
