      "type": "control"
    },
    {
      "fromId": "append_assistant",
      "fromPortId": "control-out",
      "toId": "save_assistant",
      "toPortId": "control-in",
      "type": "control"
    },
    {
      "fromId": "save_assistant",
      "fromPortId": "control-out",
      "toId": "show_proposal",
