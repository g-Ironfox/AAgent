    },
    {
      "fromId": "save_turn_tokens",
      "fromPortId": "control-out",
      "toId": "turn_continue",
      "toPortId": "control-in",
      "type": "control"
    },
    {
      "fromId": "in",
      "fromPortId": "workflow:task",
      "toId": "task_message",
      "toPortId": "content-in",
      "type": "content"
    },
    {
      "fromId": "system_prompt",
      "fromPortId": "content-out",
      "toId": "system",
      "toPortId": "content-in",
      "type": "content"
    },
    {
