      "type": "content"
    },
    {
      "fromId": "initial_history",
      "fromPortId": "list-out",
      "toId": "create_history",
      "toPortId": "initial-value",
      "type": "list-content"
    },
    {
      "fromId": "start_token",
      "fromPortId": "content-out",
      "toId": "initial_token_list",
      "toPortId": "content-in-0",
      "type": "content"
    },
    {
      "fromId": "initial_token_list",
      "fromPortId": "list-out",
      "toId": "create_turn_tokens",
