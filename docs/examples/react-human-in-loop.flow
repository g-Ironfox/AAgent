      "type": "list-content"
    },
    {
      "fromId": "create_turn_tokens",
      "fromPortId": "context-id",
      "toId": "turn_gate",
      "toPortId": "context-id",
      "type": "content"
    },
    {
      "fromId": "turn_in",
      "fromPortId": "function:history_id",
      "toId": "read_for_llm",
      "toPortId": "context-id",
      "type": "content"
    },
    {
      "fromId": "read_for_llm",
      "fromPortId": "value-out",
      "toId": "llm",
      "toPortId": "messages-in",
      "type": "list-content"
    },
    {
      "fromId": "llm",
      "fromPortId": "output",
      "toId": "assistant_message",
      "toPortId": "content-in",
      "type": "content"
    },
    {
      "fromId": "llm",
      "fromPortId": "output",
      "toId": "show_proposal",
      "toPortId": "content-in",
      "type": "content"
    },
    {
      "fromId": "turn_in",
      "fromPortId": "function:history_id",
