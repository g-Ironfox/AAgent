{
  "schema_version": "2.0",
  "description": "ReAct with native tool calls, per-call human approval, durable history and function-scoped branches.",
  "input_ports": [
    {
      "name": "task",
      "type": "content"
    }
  ],
  "output_ports": [],
  "metadata": {
    "structs": [
      {
        "id": "ToolCallCount",
        "name": "ToolCallCount",
        "color": "#3976A8",
        "fields": [
          {
            "name": "count",
            "type": "number",
            "required": true
          }
        ]
      },
      {
        "id": "CallFunction",
        "name": "CallFunction",
        "color": "#3976A8",
        "fields": [
          {
            "name": "name",
            "type": "content",
            "required": true
          },
          {
            "name": "arguments",
            "type": "content",
            "required": true
          }
        ]
      },
      {
        "id": "ToolCall",
        "name": "ToolCall",
        "color": "#3976A8",
        "fields": [
          {
            "name": "id",
            "type": "content",
            "required": true
          },
          {
            "name": "type",
            "type": "content",
            "required": true
          },
          {
            "name": "function",
            "type": "struct:CallFunction",
            "required": true
          }
        ]
      }
    ],
    "functions": [
      {
        "id": "append_history",
        "name": "append_history",
        "input_ports": [
          {
            "name": "history_id",
            "type": "content"
          },
          {
            "name": "message",
            "type": "content"
          }
        ],
        "output_ports": []
      },
      {
        "id": "queue_turn",
        "name": "queue_turn",
        "input_ports": [
          {
            "name": "tokens_id",
            "type": "content"
          }
        ],
        "output_ports": []
      },
      {
        "id": "build_assistant",
        "name": "build_assistant",
        "input_ports": [
          {
            "name": "content",
            "type": "content"
          },
          {
            "name": "reasoning",
            "type": "content"
          },
          {
            "name": "calls",
            "type": "list-content"
          }
        ],
        "output_ports": [
          {
            "name": "message",
            "type": "content"
          }
        ]
      },
      {
        "id": "record_tool_result",
        "name": "record_tool_result",
        "input_ports": [
          {
            "name": "history_id",
            "type": "content"
          },
          {
            "name": "call_id",
            "type": "content"
          },
          {
            "name": "content",
            "type": "content"
          }
        ],
        "output_ports": []
      },
      {
        "id": "execute_reviewed_tool",
        "name": "execute_reviewed_tool",
        "input_ports": [
          {
            "name": "name",
            "type": "content"
          },
          {
            "name": "arguments",
            "type": "content"
          }
        ],
        "output_ports": [
          {
            "name": "observation",
            "type": "content"
          }
        ]
      },
      {
        "id": "review_tool",
        "name": "review_tool",
        "input_ports": [
          {
            "name": "history_id",
            "type": "content"
          },
          {
            "name": "stop_id",
            "type": "content"
          },
          {
            "name": "call",
            "type": "content"
          }
        ],
        "output_ports": []
      },
      {
        "id": "react_turn",
        "name": "react_turn",
        "input_ports": [
          {
            "name": "history_id",
            "type": "content"
          },
          {
            "name": "tokens_id",
            "type": "content"
          }
        ],
        "output_ports": []
      }
    ],
    "tools": [
      {
        "name": "workspace.list_files",
        "kind": "local",
        "input_ports": [],
        "output_ports": [
          {
            "name": "items",
            "type": "list-content"
          },
          {
            "name": "revision",
            "type": "number"
          }
        ]
      },
      {
        "name": "workspace.get_file",
        "kind": "local",
        "input_ports": [
          {
            "name": "file_id",
            "type": "content"
          }
        ],
        "output_ports": [
          {
            "name": "output",
            "type": "content"
          }
        ]
      }
    ]
  },
  "nodes": [
    {
      "id": "in",
      "type": "input",
      "name": "in",
      "x": 80,
      "y": 100,
      "workflowPorts": [
        {
          "id": "workflow:task",
          "name": "task",
          "type": "content"
        }
      ]
    },
    {
      "id": "system_prompt",
      "type": "construct_content",
      "name": "system prompt",
      "x": 340,
      "y": 100,
      "arguments": {
        "append_items": [
          {
            "type": "fixed",
            "value": "You are a ReAct assistant. Respond in the user's language. Briefly explain your next step and use the provided tools when useful. Every tool call requires the human to reply APPROVE before execution. A rejection is returned as a tool observation. Never claim a proposed call has already run. Ask the user for feedback when no tool is needed. The user can end the run with DONE. Use only the provided tool names and their exact argument schemas."
          }
        ]
      },
      "dataInputPorts": []
    },
    {
      "id": "system",
      "type": "construct_message",
      "name": "system",
      "x": 600,
      "y": 100,
      "arguments": {
        "role": "system"
      }
    },
    {
      "id": "task_message",
      "type": "construct_message",
      "name": "task message",
      "x": 860,
      "y": 100,
      "arguments": {
        "role": "user"
      }
    },
    {
      "id": "initial_history",
      "type": "construct_list",
      "name": "initial history",
      "x": 1120,
      "y": 100,
      "arguments": {
        "item_type": "content",
        "initial_value_count": 2
      },
      "dataInputPorts": [
        "content-in-0",
        "content-in-1"
      ]
    },
    {
      "id": "create_history",
      "type": "context_create",
      "name": "create history",
      "x": 1380,
      "y": 100,
      "arguments": {
        "value_type": "list-content"
      }
    },
    {
      "id": "start_token",
      "type": "construct_content",
      "name": "start token",
      "x": 1640,
      "y": 100,
      "arguments": {
        "append_items": [
          {
            "type": "fixed",
            "value": "next"
          }
        ]
      },
      "dataInputPorts": []
    },
    {
      "id": "initial_tokens",
      "type": "construct_list",
      "name": "initial tokens",
      "x": 1900,
      "y": 100,
      "arguments": {
        "item_type": "content",
        "initial_value_count": 1
      },
      "dataInputPorts": [
        "content-in-0"
      ]
    },
    {
      "id": "create_tokens",
      "type": "context_create",
      "name": "create tokens",
      "x": 2160,
      "y": 100,
      "arguments": {
        "value_type": "list-content"
      }
    },
    {
      "id": "turn_gate",
      "type": "while_pop",
      "name": "turn gate",
      "x": 2420,
      "y": 100,
      "arguments": {
        "value_type": "list-content"
      }
    },
    {
      "id": "call_turn",
      "type": "function_call",
      "name": "call turn",
      "x": 2680,
      "y": 100,
      "arguments": {
        "function_id": "react_turn"
      }
    },
    {
      "id": "out",
      "type": "output",
      "name": "out",
      "x": 2940,
      "y": 100,
      "workflowPorts": []
    },
    {
      "id": "append_history_in",
      "type": "function_input",
      "name": "append history in",
      "x": 80,
      "y": 700,
      "function_id": "append_history"
    },
    {
      "id": "history_read",
      "type": "context_read",
      "name": "history read",
      "x": 340,
      "y": 700,
      "arguments": {
        "value_type": "list-content"
      }
    },
    {
      "id": "history_append",
      "type": "list_append",
      "name": "history append",
      "x": 600,
      "y": 700,
      "arguments": {
        "item_type": "content",
        "position": "end"
      }
    },
    {
      "id": "history_write",
      "type": "context_write",
      "name": "history write",
      "x": 860,
      "y": 700,
      "arguments": {
        "value_type": "list-content"
      }
    },
    {
      "id": "history_return",
      "type": "function_output",
      "name": "history return",
      "x": 1120,
      "y": 700,
      "function_id": "append_history"
    },
    {
      "id": "queue_turn_in",
      "type": "function_input",
      "name": "queue turn in",
      "x": 80,
      "y": 1300,
      "function_id": "queue_turn"
    },
    {
      "id": "tokens_read",
      "type": "context_read",
      "name": "tokens read",
      "x": 340,
      "y": 1300,
      "arguments": {
        "value_type": "list-content"
      }
    },
    {
      "id": "next_token",
      "type": "construct_content",
      "name": "next token",
      "x": 600,
      "y": 1300,
      "arguments": {
        "append_items": [
          {
            "type": "fixed",
            "value": "next"
          }
        ]
      },
      "dataInputPorts": []
    },
    {
      "id": "tokens_append",
      "type": "list_append",
      "name": "tokens append",
      "x": 860,
      "y": 1300,
      "arguments": {
        "item_type": "content",
        "position": "end"
      }
    },
    {
      "id": "tokens_write",
      "type": "context_write",
      "name": "tokens write",
      "x": 1120,
      "y": 1300,
      "arguments": {
        "value_type": "list-content"
      }
    },
    {
      "id": "tokens_return",
      "type": "function_output",
      "name": "tokens return",
      "x": 1380,
      "y": 1300,
      "function_id": "queue_turn"
    },
    {
      "id": "build_assistant_in",
      "type": "function_input",
      "name": "build assistant in",
      "x": 80,
      "y": 1900,
      "function_id": "build_assistant"
    },
    {
      "id": "build_message",
      "type": "construct_message",
      "name": "build message",
      "x": 340,
      "y": 1900,
      "arguments": {
        "role": "assistant"
      }
    },
    {
      "id": "build_return",
      "type": "function_output",
      "name": "build return",
      "x": 600,
      "y": 1900,
      "function_id": "build_assistant"
    },
    {
      "id": "record_tool_result_in",
      "type": "function_input",
      "name": "record tool result in",
      "x": 80,
      "y": 2500,
      "function_id": "record_tool_result"
    },
    {
      "id": "result_message",
      "type": "construct_message",
      "name": "result message",
      "x": 340,
      "y": 2500,
      "arguments": {
        "role": "tool"
      }
    },
    {
      "id": "result_save",
      "type": "function_call",
      "name": "result save",
      "x": 600,
      "y": 2500,
      "arguments": {
        "function_id": "append_history"
      }
    },
    {
      "id": "result_return",
      "type": "function_output",
      "name": "result return",
      "x": 860,
      "y": 2500,
      "function_id": "record_tool_result"
    },
    {
      "id": "execute_reviewed_tool_in",
      "type": "function_input",
      "name": "execute reviewed tool in",
      "x": 80,
      "y": 3100,
      "function_id": "execute_reviewed_tool"
    },
    {
      "id": "execute_tool",
      "type": "json_tool",
      "name": "execute tool",
      "x": 340,
      "y": 3100
    },
    {
      "id": "execute_success",
      "type": "function_output",
      "name": "execute success",
      "x": 600,
      "y": 3100,
      "function_id": "execute_reviewed_tool"
    },
    {
      "id": "execute_error",
      "type": "function_output",
      "name": "execute error",
      "x": 860,
      "y": 3100,
      "function_id": "execute_reviewed_tool"
    },
    {
      "id": "review_tool_in",
      "type": "function_input",
      "name": "review tool in",
      "x": 80,
      "y": 3700,
      "function_id": "review_tool"
    },
    {
      "id": "review_parse",
      "type": "json_to_struct",
      "name": "review parse",
      "x": 340,
      "y": 3700,
      "arguments": {
        "value_type": "struct:ToolCall"
      }
    },
    {
      "id": "review_id",
      "type": "struct_get",
      "name": "review id",
      "x": 600,
      "y": 3700,
      "arguments": {
        "struct_id": "ToolCall",
        "field": "id"
      },
      "dataInputPorts": [
        "struct-in"
      ]
    },
    {
      "id": "review_function",
      "type": "struct_get",
      "name": "review function",
      "x": 860,
      "y": 3700,
      "arguments": {
        "struct_id": "ToolCall",
        "field": "function"
      },
      "dataInputPorts": [
        "struct-in"
      ]
    },
    {
      "id": "review_name",
      "type": "struct_get",
      "name": "review name",
      "x": 1120,
      "y": 3700,
      "arguments": {
        "struct_id": "CallFunction",
        "field": "name"
      },
      "dataInputPorts": [
        "struct-in"
      ]
    },
    {
      "id": "review_args",
      "type": "struct_get",
      "name": "review args",
      "x": 1380,
      "y": 3700,
      "arguments": {
        "struct_id": "CallFunction",
        "field": "arguments"
      },
      "dataInputPorts": [
        "struct-in"
      ]
    },
    {
      "id": "review_stop",
      "type": "context_read",
      "name": "review stop",
      "x": 1640,
      "y": 3700,
      "arguments": {
        "value_type": "content"
      }
    },
    {
      "id": "review_stop_route",
      "type": "router",
      "name": "review stop route",
      "x": 1900,
      "y": 3700,
      "arguments": {
        "branches": [
          {
            "id": "stopped",
            "name": "DONE"
          }
        ]
      }
    },
    {
      "id": "review_skipped",
      "type": "construct_content",
      "name": "review skipped",
      "x": 2160,
      "y": 3700,
      "arguments": {
        "append_items": [
          {
            "type": "fixed",
            "value": "Cancelled: user ended this run; this tool was not executed."
          }
        ]
      },
      "dataInputPorts": []
    },
    {
      "id": "review_skip_save",
      "type": "function_call",
      "name": "review skip save",
      "x": 2420,
      "y": 3700,
      "arguments": {
        "function_id": "record_tool_result"
      }
    },
    {
      "id": "review_skip_return",
      "type": "function_output",
      "name": "review skip return",
      "x": 2680,
      "y": 3700,
      "function_id": "review_tool"
    },
    {
      "id": "review_prompt",
      "type": "construct_content",
      "name": "review prompt",
      "x": 2940,
      "y": 3700,
      "arguments": {
        "append_items": [
          {
            "type": "fixed",
            "value": "Tool request (full call):\n"
          },
          {
            "type": "port",
            "port_id": "value"
          },
          {
            "type": "fixed",
            "value": "\nReply APPROVE to execute this exact call; DONE to end; any other reply rejects it and is sent back as feedback."
          }
        ]
      },
      "dataInputPorts": [
        "value"
      ]
    },
    {
      "id": "review_show",
      "type": "output_to_terminal",
      "name": "review show",
      "x": 3200,
      "y": 3700
    },
    {
      "id": "review_wait",
      "type": "wait_terminal_event",
      "name": "review wait",
      "x": 3460,
      "y": 3700
    },
    {
      "id": "review_inputs",
      "type": "read_terminal_input",
      "name": "review inputs",
      "x": 3720,
      "y": 3700
    },
    {
      "id": "review_latest",
      "type": "list_get",
      "name": "review latest",
      "x": 3980,
      "y": 3700,
      "arguments": {
        "value_type": "list-content",
        "index_source": "fixed",
        "index": -1
      }
    },
    {
      "id": "review_decision",
      "type": "router",
      "name": "review decision",
      "x": 4240,
      "y": 3700,
      "arguments": {
        "branches": [
          {
            "id": "approve",
            "name": "APPROVE"
          },
          {
            "id": "done",
            "name": "DONE"
          }
        ]
      }
    },
    {
      "id": "review_execute",
      "type": "function_call",
      "name": "review execute",
      "x": 4500,
      "y": 3700,
      "arguments": {
        "function_id": "execute_reviewed_tool"
      }
    },
    {
      "id": "review_show_result",
      "type": "output_to_terminal",
      "name": "review show result",
      "x": 4760,
      "y": 3700
    },
    {
      "id": "review_approved_save",
      "type": "function_call",
      "name": "review approved save",
      "x": 5020,
      "y": 3700,
      "arguments": {
        "function_id": "record_tool_result"
      }
    },
    {
      "id": "review_approved_return",
      "type": "function_output",
      "name": "review approved return",
      "x": 5280,
      "y": 3700,
      "function_id": "review_tool"
    },
    {
      "id": "review_done",
      "type": "construct_content",
      "name": "review done",
      "x": 5540,
      "y": 3700,
      "arguments": {
        "append_items": [
          {
            "type": "fixed",
            "value": "DONE"
          }
        ]
      },
      "dataInputPorts": []
    },
    {
      "id": "review_set_stop",
      "type": "context_write",
      "name": "review set stop",
      "x": 5800,
      "y": 3700,
      "arguments": {
        "value_type": "content"
      }
    },
    {
      "id": "review_cancelled",
      "type": "construct_content",
      "name": "review cancelled",
      "x": 6060,
      "y": 3700,
      "arguments": {
        "append_items": [
          {
            "type": "fixed",
            "value": "Cancelled: user ended this run; this tool was not executed."
          }
        ]
      },
      "dataInputPorts": []
    },
    {
      "id": "review_cancel_save",
      "type": "function_call",
      "name": "review cancel save",
      "x": 6320,
      "y": 3700,
      "arguments": {
        "function_id": "record_tool_result"
      }
    },
    {
      "id": "review_cancel_return",
      "type": "function_output",
      "name": "review cancel return",
      "x": 6580,
      "y": 3700,
      "function_id": "review_tool"
    },
    {
      "id": "review_rejected",
      "type": "construct_content",
      "name": "review rejected",
      "x": 6840,
      "y": 3700,
      "arguments": {
        "append_items": [
          {
            "type": "fixed",
            "value": "Rejected by human; tool was not executed. Feedback: "
          },
          {
            "type": "port",
            "port_id": "value"
          },
          {
            "type": "fixed",
            "value": ""
          }
        ]
      },
      "dataInputPorts": [
        "value"
      ]
    },
    {
      "id": "review_reject_save",
      "type": "function_call",
      "name": "review reject save",
      "x": 7100,
      "y": 3700,
      "arguments": {
        "function_id": "record_tool_result"
      }
    },
    {
      "id": "review_reject_return",
      "type": "function_output",
      "name": "review reject return",
      "x": 7360,
      "y": 3700,
      "function_id": "review_tool"
    },
    {
      "id": "react_turn_in",
      "type": "function_input",
      "name": "react turn in",
      "x": 80,
      "y": 4300,
      "function_id": "react_turn"
    },
    {
      "id": "read_for_llm",
      "type": "context_read",
      "name": "read for llm",
      "x": 340,
      "y": 4300,
      "arguments": {
        "value_type": "list-content"
      }
    },
    {
      "id": "llm",
      "type": "llm",
      "name": "llm",
      "x": 600,
      "y": 4300,
      "arguments": {
        "model": "REPLACE_WITH_MODEL_ID",
        "think": true,
        "tool_calls": true,
        "tools": [
          "workspace.list_files",
          "workspace.get_file"
        ]
      }
    },
    {
      "id": "normalize_content",
      "type": "construct_content",
      "name": "normalize content",
      "x": 860,
      "y": 4300,
      "arguments": {
        "append_items": [
          {
            "type": "fixed",
            "value": ""
          },
          {
            "type": "port",
            "port_id": "value"
          },
          {
            "type": "fixed",
            "value": ""
          }
        ]
      },
      "dataInputPorts": [
        "value"
      ]
    },
    {
      "id": "assistant_message",
      "type": "function_call",
      "name": "assistant message",
      "x": 1120,
      "y": 4300,
      "arguments": {
        "function_id": "build_assistant"
      }
    },
    {
      "id": "save_assistant",
      "type": "function_call",
      "name": "save assistant",
      "x": 1380,
      "y": 4300,
      "arguments": {
        "function_id": "append_history"
      }
    },
    {
      "id": "turn_count",
      "type": "list_length",
      "name": "tool call count",
      "x": 1640,
      "y": 4300,
      "arguments": {
        "value_type": "list-content"
      }
    },
    {
      "id": "turn_count_value",
      "type": "construct_struct",
      "name": "turn count value",
      "x": 1900,
      "y": 4300,
      "arguments": {
        "struct_id": "ToolCallCount"
      },
      "dataInputPorts": [
