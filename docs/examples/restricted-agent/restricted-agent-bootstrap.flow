          }
        ]
      },
      {
        "id": "completed_record_fields",
        "name": "completed_record_fields",
        "color": "#3976A8",
        "fields": [
          {
            "name": "task_record",
            "type": "content",
            "required": true
          },
          {
            "name": "iterator_status",
            "type": "content",
            "required": true
          },
          {
            "name": "iterator_result",
            "type": "content",
            "required": true
          }
        ]
      },
      {
        "id": "iterator_arguments_fields",
        "name": "iterator_arguments_fields",
        "color": "#3976A8",
        "fields": [
          {
            "name": "record",
            "type": "content",
            "required": true
          }
        ]
      }
    ],
    "functions": [
      {
        "id": "initialize_run",
        "name": "初始化任务记录",
        "input_ports": [
          {
            "name": "task",
            "type": "content"
          }
        ],
        "output_ports": [
          {
            "name": "run",
            "type": "struct:Run"
          }
        ]
      },
      {
        "id": "run_with_recovery",
        "name": "执行主流程与逐级恢复",
        "input_ports": [
          {
            "name": "run",
            "type": "struct:Run"
          }
        ],
        "output_ports": [
          {
            "name": "outcome",
            "type": "struct:Outcome"
          },
          {
            "name": "attempts",
            "type": "list-content"
          }
        ]
      },
      {
        "id": "attempt_main",
        "name": "尝试一次主流程",
        "input_ports": [
          {
            "name": "task",
            "type": "content"
          },
          {
            "name": "checkpoint_seq",
            "type": "number"
          },
          {
            "name": "source",
            "type": "content"
          },
          {
            "name": "success_status",
            "type": "content"
          }
        ],
        "output_ports": [
          {
            "name": "attempt",
            "type": "struct:Attempt"
          }
        ]
      },
      {
        "id": "remember_attempt",
        "name": "保存本次尝试",
        "input_ports": [
          {
            "name": "run",
            "type": "struct:Run"
          },
          {
            "name": "attempt",
            "type": "struct:Attempt"
          },
          {
            "name": "state_id",
            "type": "content"
          },
          {
            "name": "attempts_id",
            "type": "content"
          }
        ],
        "output_ports": []
      },
      {
        "id": "restore_main_version",
        "name": "回退主流程版本",
        "input_ports": [
          {
            "name": "content",
            "type": "content"
          }
        ],
        "output_ports": []
      },
      {
        "id": "retry_version",
        "name": "尝试回退版本",
        "input_ports": [
          {
            "name": "run",
            "type": "struct:Run"
          },
          {
            "name": "version",
            "type": "struct:RecoveryVersion"
          },
          {
            "name": "state_id",
            "type": "content"
          },
          {
            "name": "attempts_id",
            "type": "content"
          },
          {
            "name": "versions_id",
            "type": "content"
          }
        ],
        "output_ports": []
      },
      {
        "id": "write_record",
        "name": "写入任务记录",
        "input_ports": [
          {
            "name": "record_id",
            "type": "content"
          },
          {
            "name": "record_name",
            "type": "content"
          },
          {
            "name": "content",
            "type": "content"
          }
        ],
        "output_ports": []
      },
      {
        "id": "finish_task",
        "name": "记录结果并迭代经验",
        "input_ports": [
          {
            "name": "run",
            "type": "struct:Run"
          },
          {
            "name": "outcome",
            "type": "struct:Outcome"
          },
          {
            "name": "attempts",
            "type": "list-content"
          }
        ],
        "output_ports": [
          {
            "name": "status",
            "type": "content"
          },
          {
            "name": "result",
            "type": "content"
          },
          {
            "name": "record_file_id",
            "type": "content"
          }
        ]
      },
      {
        "id": "call_iterator",
        "name": "调用经验迭代器",
        "input_ports": [
          {
            "name": "record",
            "type": "content"
          }
        ],
        "output_ports": [
          {
            "name": "status",
            "type": "content"
          },
          {
            "name": "result",
            "type": "content"
          }
        ]
      }
    ],
    "tools": [
      {
        "name": "workspace.create_checkpoint",
        "kind": "local",
        "input_ports": [
          {
            "name": "name",
            "type": "content"
          }
        ],
        "output_ports": [
          {
            "name": "output",
            "type": "content"
          }
        ]
      },
      {
        "name": "workspace.list_files",
        "kind": "local",
        "input_ports": [],
        "output_ports": [
          {
            "name": "items",
            "type": "content"
          },
          {
            "name": "revision",
            "type": "number"
          }
        ]
      },
      {
        "name": "workspace.create_file",
        "kind": "local",
        "input_ports": [
          {
            "name": "name",
            "type": "content"
          },
          {
            "name": "content",
            "type": "content"
          }
        ],
        "output_ports": [
          {
            "name": "output",
            "type": "content"
          }
        ]
      },
      {
        "name": "workspace.get_file_recovery_plan",
        "kind": "local",
        "input_ports": [
          {
            "name": "file_id",
            "type": "content"
          },
          {
            "name": "stable_file_id",
            "type": "content"
          },
          {
            "name": "checkpoint_seq",
            "type": "number"
          }
        ],
        "output_ports": [
          {
            "name": "versions",
            "type": "content"
          }
        ]
      },
      {
        "name": "workspace.get_file",
        "kind": "local",
        "input_ports": [
          {
            "name": "file_id",
            "type": "content"
          }
        ],
        "output_ports": [
          {
            "name": "output",
            "type": "content"
          }
        ]
      },
      {
        "name": "workspace.update_file",
        "kind": "local",
        "input_ports": [
          {
            "name": "file_id",
            "type": "content"
          },
          {
            "name": "name",
            "type": "content"
          },
          {
            "name": "content",
            "type": "content"
          },
          {
            "name": "revision",
            "type": "number"
          }
        ],
        "output_ports": [
          {
            "name": "output",
            "type": "content"
          }
        ]
      },
      {
        "name": "workspace.checkpoint_diff",
        "kind": "local",
        "input_ports": [
          {
            "name": "seq",
            "type": "number"
          }
        ],
        "output_ports": [
          {
            "name": "seq",
            "type": "number"
          },
          {
            "name": "parent_seq",
            "type": "content"
          },
          {
            "name": "changes",
            "type": "content"
          }
        ]
      }
    ]
  },
  "nodes": [
    {
      "id": "in",
      "type": "input",
