          },
          {
            "name": "checkpoint_before",
            "type": "number",
            "required": true
          },
          {
            "name": "workspace_before",
            "type": "content",
            "required": true
          },
          {
            "name": "checkpoint_after",
            "type": "number",
            "required": true
          },
          {
            "name": "workspace_after",
            "type": "content",
            "required": true
          },
          {
            "name": "workspace_changes",
