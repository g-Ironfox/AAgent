{
  "schema_version": "2.0",
  "description": "固定引导：记录任务；失败后逐级回退主流程重试，到 stable 为止；记录结果并更新经验。",
  "input_ports": [
    {
      "name": "task",
      "type": "content"
    }
  ],
  "output_ports": [
    {
      "name": "status",
      "type": "content"
    },
    {
      "name": "result",
      "type": "content"
    },
    {
      "name": "record_file_id",
      "type": "content"
    }
  ],
  "metadata": {
    "structs": [
      {
        "id": "Run",
        "name": "Run",
        "color": "#3976A8",
        "fields": [
          {
            "name": "task",
            "type": "content",
            "required": true
          },
          {
            "name": "record_id",
            "type": "content",
            "required": true
          },
          {
            "name": "record_name",
            "type": "content",
            "required": true
          },
          {
            "name": "checkpoint_before",
            "type": "number",
            "required": true
          },
          {
            "name": "workspace_before",
            "type": "content",
            "required": true
          }
        ]
      },
      {
        "id": "Outcome",
        "name": "Outcome",
        "color": "#3976A8",
        "fields": [
          {
            "name": "status",
            "type": "content",
            "required": true
          },
          {
            "name": "result",
            "type": "content",
            "required": true
          },
          {
            "name": "error",
            "type": "content",
            "required": true
          }
        ]
      },
      {
        "id": "Attempt",
        "name": "Attempt",
        "color": "#3976A8",
        "fields": [
          {
            "name": "status",
            "type": "content",
            "required": true
          },
          {
            "name": "result",
            "type": "content",
            "required": true
          },
          {
            "name": "error",
            "type": "content",
            "required": true
          },
          {
            "name": "checkpoint_seq",
            "type": "number",
            "required": true
          },
          {
            "name": "source",
            "type": "content",
            "required": true
          }
        ]
      },
      {
        "id": "RecoveryVersion",
        "name": "RecoveryVersion",
        "color": "#3976A8",
        "fields": [
          {
            "name": "content",
            "type": "content",
            "required": true
          },
          {
            "name": "checkpoint_seq",
            "type": "number",
            "required": true
          },
          {
            "name": "source",
            "type": "content",
            "required": true
          }
        ]
      },
      {
        "id": "initial_record_fields",
        "name": "initial_record_fields",
        "color": "#3976A8",
        "fields": [
          {
            "name": "status",
            "type": "content",
            "required": true
          },
          {
            "name": "task",
            "type": "content",
            "required": true
          },
          {
            "name": "checkpoint_before",
            "type": "number",
            "required": true
          },
          {
            "name": "workspace_before",
            "type": "content",
            "required": true
          }
        ]
      },
      {
        "id": "main_arguments_fields",
        "name": "main_arguments_fields",
        "color": "#3976A8",
        "fields": [
          {
            "name": "task",
            "type": "content",
            "required": true
          }
        ]
      },
      {
        "id": "progress_record_fields",
        "name": "progress_record_fields",
        "color": "#3976A8",
        "fields": [
          {
            "name": "task",
            "type": "content",
            "required": true
          },
          {
            "name": "status",
            "type": "content",
            "required": true
          },
          {
            "name": "result",
            "type": "content",
            "required": true
          },
          {
            "name": "error",
            "type": "content",
            "required": true
          },
          {
            "name": "checkpoint_before",
            "type": "number",
            "required": true
          },
          {
            "name": "workspace_before",
            "type": "content",
            "required": true
          },
          {
            "name": "attempts",
            "type": "list-content",
            "required": true
