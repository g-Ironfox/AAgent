{
  "schema_version": "2.0",
  "description": "Process-scheduled tool-loop agent with optional ask_human interaction and durable conversation history.",
  "input_ports": [
    {
      "name": "task",
      "type": "content"
    }
  ],
  "output_ports": [],
  "metadata": {
    "structs": [
      {
        "id": "ToolCallCount",
        "name": "ToolCallCount",
        "color": "#3976A8",
        "fields": [
          {
            "name": "count",
            "type": "number",
            "required": true
          }
        ]
      },
      {
        "id": "CallFunction",
        "name": "CallFunction",
        "color": "#3976A8",
        "fields": [
          {
            "name": "name",
            "type": "content",
            "required": true
          },
          {
            "name": "arguments",
            "type": "content",
            "required": true
          }
        ]
      },
      {
        "id": "ToolCall",
        "name": "ToolCall",
        "color": "#3976A8",
        "fields": [
          {
            "name": "id",
            "type": "content",
            "required": true
          },
          {
            "name": "type",
            "type": "content",
            "required": true
          },
          {
            "name": "function",
            "type": "struct:CallFunction",
            "required": true
          }
        ]
      },
      {
        "id": "AskHumanArgs",
        "name": "AskHumanArgs",
        "color": "#3976A8",
        "fields": [
          {
            "name": "question",
            "type": "content",
            "required": true
          }
        ]
      },
      {
        "id": "HumanReply",
        "name": "HumanReply",
        "color": "#3976A8",
        "fields": [
          {
            "name": "replies",
            "type": "list-content",
            "required": true
          }
        ]
      },
      {
        "id": "Assistant",
        "name": "Assistant",
        "color": "#3976A8",
        "fields": [
          {
            "name": "role",
            "type": "content",
            "required": true
          },
          {
            "name": "content",
            "type": "content",
            "required": true
          },
          {
            "name": "reasoning_content",
            "type": "content",
            "required": true
          },
          {
            "name": "tool_calls",
            "type": "list-struct:ToolCall",
            "required": true
          }
        ]
      },
      {
        "id": "ToolMessage",
        "name": "ToolMessage",
        "color": "#3976A8",
        "fields": [
          {
            "name": "role",
            "type": "content",
            "required": true
          },
          {
            "name": "content",
            "type": "content",
            "required": true
          },
          {
            "name": "tool_call_id",
            "type": "content",
            "required": true
          }
        ]
      }
    ],
    "functions": [
      {
        "id": "append_history",
        "name": "append_history",
        "input_ports": [
          {
            "name": "history_id",
            "type": "content"
          },
          {
            "name": "message",
            "type": "content"
          }
        ],
        "output_ports": []
      },
      {
        "id": "queue_turn",
        "name": "queue_turn",
        "input_ports": [
          {
            "name": "tokens_id",
            "type": "content"
          }
        ],
        "output_ports": []
      },
      {
        "id": "build_assistant",
        "name": "build_assistant",
        "input_ports": [
          {
            "name": "content",
            "type": "content"
          },
          {
            "name": "reasoning",
            "type": "content"
          },
          {
            "name": "calls",
            "type": "list-content"
          }
        ],
        "output_ports": [
          {
            "name": "message",
            "type": "content"
          }
        ]
      },
      {
        "id": "record_tool_result",
        "name": "record_tool_result",
        "input_ports": [
          {
            "name": "history_id",
            "type": "content"
          },
          {
            "name": "call_id",
            "type": "content"
          },
          {
            "name": "content",
            "type": "content"
          }
        ],
        "output_ports": []
      },
      {
        "id": "run_one_tool",
        "name": "run_one_tool",
        "input_ports": [
          {
            "name": "history_id",
            "type": "content"
          },
          {
            "name": "call",
            "type": "content"
          },
          {
            "name": "batch_stop_id",
            "type": "content"
          }
        ],
        "output_ports": []
      },
      {
        "id": "tool_loop_turn",
        "name": "tool_loop_turn",
        "input_ports": [
          {
            "name": "history_id",
            "type": "content"
          },
          {
            "name": "tokens_id",
            "type": "content"
          }
        ],
        "output_ports": []
      }
    ],
    "tools": [
      {
        "name": "workspace.list_files",
        "kind": "local",
        "input_ports": [],
        "output_ports": [
          {
            "name": "items",
            "type": "list-content"
          },
          {
            "name": "revision",
            "type": "number"
          }
        ]
      },
      {
        "name": "workspace.get_file",
        "kind": "local",
        "input_ports": [
          {
            "name": "file_id",
            "type": "content"
          }
        ],
        "output_ports": [
          {
            "name": "output",
            "type": "content"
          }
        ]
      }
    ]
  },
  "nodes": [
    {
      "id": "in",
      "type": "input",
      "name": "in",
      "x": 80,
      "y": 100,
      "workflowPorts": [
        {
          "id": "workflow:task",
          "name": "task",
          "type": "content"
        }
      ]
    },
    {
      "id": "system_prompt",
      "type": "construct_content",
      "name": "system prompt",
      "x": 340,
      "y": 100,
      "arguments": {
        "append_items": [
          {
            "type": "fixed",
            "value": "You are a ReAct assistant. Respond in the user's language. Use only the provided tools and their declared schemas when needed. Tool calls are executed automatically, so use them only when they are necessary and safe. Call ask_human when you need clarification, a decision, or information only the user can provide. Put a clear, non-empty question in its question argument, in the user's language. Ask one focused question at a time. The result contains only new human replies; an empty replies list means no new answer was available. After ask_human, remaining calls in that batch are skipped so you can replan. After receiving tool results, continue reasoning and call more tools if needed. When no more tools are needed, give a concise, accurate final answer. Never claim an unexecuted action succeeded."
          }
        ]
      },
      "dataInputPorts": []
    },
    {
      "id": "system",
      "type": "construct_message",
      "name": "system",
      "x": 600,
      "y": 100,
      "arguments": {
        "role": "system"
      }
    },
    {
      "id": "task_message",
