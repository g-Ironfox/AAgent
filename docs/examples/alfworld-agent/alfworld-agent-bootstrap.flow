        "input_ports": [
          {
            "name": "task",
            "type": "content"
          },
          {
            "name": "checkpoint_seq",
            "type": "number"
          },
          {
            "name": "source",
            "type": "content"
          },
          {
            "name": "success_status",
            "type": "content"
          }
        ],
        "output_ports": [
          {
            "name": "attempt",
            "type": "struct:Attempt"
          }
        ]
      },
      {
        "id": "remember_attempt",
        "name": "保存本次尝试",
        "input_ports": [
          {
            "name": "run",
            "type": "struct:Run"
          },
          {
            "name": "attempt",
            "type": "struct:Attempt"
          },
          {
            "name": "state_id",
            "type": "content"
          },
          {
            "name": "attempts_id",
            "type": "content"
          }
        ],
        "output_ports": []
      },
      {
        "id": "restore_main_version",
        "name": "回退主流程版本",
        "input_ports": [
          {
            "name": "content",
            "type": "content"
          }
        ],
        "output_ports": []
      },
      {
        "id": "retry_version",
        "name": "尝试回退版本",
        "input_ports": [
          {
            "name": "run",
            "type": "struct:Run"
          },
          {
            "name": "version",
            "type": "struct:RecoveryVersion"
          },
          {
            "name": "state_id",
            "type": "content"
          },
          {
            "name": "attempts_id",
            "type": "content"
          },
          {
            "name": "versions_id",
            "type": "content"
          }
        ],
        "output_ports": []
      },
      {
        "id": "write_record",
        "name": "写入任务记录",
        "input_ports": [
          {
            "name": "record_id",
            "type": "content"
          },
          {
            "name": "record_name",
            "type": "content"
          },
          {
            "name": "content",
            "type": "content"
          }
        ],
        "output_ports": []
      },
      {
        "id": "finish_task",
        "name": "记录结果并迭代经验",
        "input_ports": [
          {
            "name": "run",
            "type": "struct:Run"
          },
          {
            "name": "outcome",
            "type": "struct:Outcome"
          },
          {
            "name": "attempts",
            "type": "list-content"
          }
        ],
        "output_ports": [
          {
            "name": "status",
            "type": "content"
          },
          {
            "name": "result",
            "type": "content"
          },
          {
            "name": "record_file_id",
            "type": "content"
          }
        ]
      },
      {
        "id": "call_iterator",
        "name": "调用经验迭代器",
        "input_ports": [
          {
            "name": "record",
            "type": "content"
          }
        ],
        "output_ports": [
          {
            "name": "status",
            "type": "content"
          },
          {
            "name": "result",
            "type": "content"
          }
        ]
      }
    ],
