  "nodes": [
    {
      "id": "in",
      "type": "input",
      "name": "in",
      "x": 80,
      "y": 100,
      "workflowPorts": []
    },
    {
      "id": "first_observation",
      "type": "function_call",
      "name": "读取环境观察",
      "x": 340,
      "y": 100,
      "arguments": {
        "function_id": "read_observation"
      }
    },
    {
      "id": "initialize",
      "type": "function_call",
      "name": "初始化 episode",
      "x": 600,
      "y": 100,
      "arguments": {
        "function_id": "initialize_episode"
      }
    },
    {
      "id": "tokens_id",
      "type": "struct_get",
      "name": "tokens id",
      "x": 860,
      "y": 100,
      "arguments": {
        "struct_id": "AlfworldSession",
        "field": "tokens_id"
      },
      "dataInputPorts": [
        "struct-in"
      ]
    },
    {
      "id": "first_turn",
      "type": "function_call",
      "name": "处理观察或结束信号",
      "x": 1120,
      "y": 100,
      "arguments": {
        "function_id": "process_observation"
      }
    },
    {
      "id": "episode_loop",
      "type": "while_pop",
      "name": "episode loop",
      "x": 1380,
      "y": 100,
      "arguments": {
        "value_type": "list-content",
        "position": "start"
      }
    },
    {
      "id": "next_turn",
      "type": "function_call",
      "name": "等待并处理下一条观察",
      "x": 1640,
      "y": 100,
      "arguments": {
        "function_id": "read_and_process"
      }
    },
    {
      "id": "finish",
      "type": "function_call",
      "name": "保存环境结果并迭代经验",
      "x": 1900,
      "y": 100,
      "arguments": {
        "function_id": "finish_episode"
      }
    },
    {
      "id": "out",
      "type": "output",
      "name": "out",
      "x": 2160,
      "y": 100,
      "workflowPorts": [
        {
          "id": "workflow:status",
          "name": "status",
          "type": "content"
        },
        {
          "id": "workflow:result",
          "name": "result",
          "type": "content"
        },
        {
          "id": "workflow:record_file_id",
          "name": "record_file_id",
          "type": "content"
        }
      ]
    },
    {
