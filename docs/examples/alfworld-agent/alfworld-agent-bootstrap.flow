    "functions": [
      {
        "id": "read_and_process",
        "name": "等待并处理下一条观察",
        "input_ports": [
          {
            "name": "session",
            "type": "struct:AlfworldSession"
          }
        ],
        "output_ports": []
      },
      {
        "id": "read_observation",
        "name": "读取环境观察",
        "input_ports": [],
        "output_ports": [
          {
            "name": "observation",
            "type": "content"
          }
        ]
      },
      {
        "id": "initialize_episode",
        "name": "初始化 episode",
        "input_ports": [
          {
            "name": "observation",
            "type": "content"
          }
        ],
        "output_ports": [
          {
            "name": "session",
            "type": "struct:AlfworldSession"
          }
        ]
      },
      {
        "id": "save_episode",
        "name": "持久化 episode 轨迹",
        "input_ports": [
          {
            "name": "session",
            "type": "struct:AlfworldSession"
          }
        ],
        "output_ports": []
      },
      {
        "id": "choose_episode_status",
        "name": "保留恢复状态",
        "input_ports": [
          {
            "name": "previous",
            "type": "content"
          },
          {
            "name": "current",
            "type": "content"
          }
        ],
        "output_ports": [
          {
            "name": "status",
            "type": "content"
          }
        ]
      },
      {
        "id": "apply_outcome",
        "name": "累计执行状态与错误",
        "input_ports": [
          {
            "name": "state_id",
            "type": "content"
          },
          {
            "name": "outcome",
            "type": "struct:Outcome"
          }
        ],
        "output_ports": []
      },
      {
        "id": "solve_turn",
        "name": "生成动作并按需恢复",
        "input_ports": [
          {
            "name": "session",
            "type": "struct:AlfworldSession"
          },
          {
            "name": "observation",
            "type": "content"
          }
        ],
        "output_ports": [
          {
            "name": "outcome",
            "type": "struct:Outcome"
          }
        ]
      },
      {
        "id": "publish_action",
        "name": "发送动作并等待下一轮",
        "input_ports": [
          {
            "name": "session",
            "type": "struct:AlfworldSession"
          },
          {
            "name": "observation",
            "type": "content"
          },
          {
            "name": "reply",
            "type": "content"
          }
        ],
        "output_ports": []
      },
      {
        "id": "process_observation",
        "name": "处理观察或结束信号",
        "input_ports": [
          {
            "name": "session",
            "type": "struct:AlfworldSession"
          },
          {
            "name": "observation",
            "type": "content"
          }
        ],
        "output_ports": []
      },
      {
        "id": "finish_episode",
        "name": "保存环境结果并迭代经验",
        "input_ports": [
          {
            "name": "session",
            "type": "struct:AlfworldSession"
          }
        ],
        "output_ports": [
          {
            "name": "status",
            "type": "content"
          },
          {
            "name": "result",
            "type": "content"
          },
          {
            "name": "record_file_id",
            "type": "content"
          }
        ]
      },
      {
        "id": "initialize_run",
        "name": "初始化任务记录",
        "input_ports": [
          {
            "name": "task",
            "type": "content"
          }
        ],
        "output_ports": [
          {
            "name": "run",
            "type": "struct:Run"
          }
        ]
      },
      {
        "id": "run_with_recovery",
        "name": "执行主流程与逐级恢复",
        "input_ports": [
          {
            "name": "run",
            "type": "struct:Run"
          }
        ],
        "output_ports": [
          {
            "name": "outcome",
            "type": "struct:Outcome"
          },
          {
            "name": "attempts",
            "type": "list-content"
          }
        ]
      },
      {
        "id": "attempt_main",
