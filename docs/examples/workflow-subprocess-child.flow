{
  "schema_version": "2.0",
  "description": "接收 name，返回问候语 reply。无需模型或外部工具。",
  "input_ports": [
    {
      "name": "name",
      "type": "content"
    }
  ],
  "output_ports": [
    {
      "name": "reply",
      "type": "content"
    }
  ],
  "nodes": [
    {
      "id": "input",
      "type": "input",
      "name": "输入",
      "x": 40,
      "y": 160,
      "workflowPorts": [
        {
          "id": "workflow:name",
          "name": "name",
          "type": "content"
        }
      ]
    },
    {
      "id": "greeting",
      "type": "construct_content",
      "name": "生成问候语",
      "x": 340,
      "y": 160,
      "dataInputPorts": [
        "name-in"
      ],
      "arguments": {
        "append_items": [
          {
            "type": "fixed",
            "value": "你好，"
          },
          {
            "type": "port",
            "port_id": "name-in"
          },
          {
            "type": "fixed",
            "value": "！"
          }
        ]
      }
    },
    {
      "id": "output",
      "type": "output",
      "name": "输出",
      "x": 660,
      "y": 160,
      "workflowPorts": [
        {
          "id": "workflow:reply",
          "name": "reply",
          "type": "content"
        }
      ]
    }
  ],
  "connections": [
    {
      "fromId": "input",
      "fromPortId": "control-out",
      "toId": "greeting",
      "toPortId": "control-in",
      "type": "control"
    },
    {
      "fromId": "greeting",
      "fromPortId": "control-out",
      "toId": "output",
      "toPortId": "control-in",
      "type": "control"
    },
    {
      "fromId": "input",
      "fromPortId": "workflow:name",
      "toId": "greeting",
      "toPortId": "name-in",
      "type": "content"
    },
    {
      "fromId": "greeting",
      "fromPortId": "content-out",
      "toId": "output",
      "toPortId": "workflow:reply",
      "type": "content"
    }
  ]
}
