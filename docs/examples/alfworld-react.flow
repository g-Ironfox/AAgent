{
  "schema_version": "2.0",
  "description": "ALFWorld minimal ReAct: native reasoning, action, observation with durable history",
  "input_ports": [],
  "output_ports": [],
  "metadata": {
    "structs": [
      {
        "id": "AlfworldAction",
        "name": "AlfworldAction",
        "color": "#3976A8",
        "fields": [
          {
            "name": "type",
