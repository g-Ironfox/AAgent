  "nodes": [
    {
      "id": "start",
      "type": "input",
      "name": "start",
      "x": 80,
      "y": 100,
      "workflowPorts": []
    },
    {
      "id": "token",
      "type": "construct_content",
      "name": "token",
      "x": 360,
      "y": 100,
      "arguments": {
        "append_items": [
          {
            "type": "fixed",
            "value": "next"
          }
        ]
      },
      "dataInputPorts": []
    },
    {
      "id": "initial_tokens",
      "type": "construct_list",
      "name": "initial tokens",
      "x": 640,
      "y": 100,
      "arguments": {
        "item_type": "content",
