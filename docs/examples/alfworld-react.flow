          },
          {
            "name": "step",
            "type": "number",
            "required": true
          },
          {
            "name": "text",
            "type": "content",
            "required": true
          }
        ]
      }
    ],
    "functions": [
      {
        "id": "alfworld_turn",
        "name": "alfworld_turn",
