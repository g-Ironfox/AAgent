{
  "schema_version": "2.0",
  "name": "react_round.flow",
  "description": "执行一轮分析与行动：读对话、请求模型、保存本轮答案、串行执行全部工具并记录观察。每次执行工具后将继续队列覆盖为单个标记；零工具调用不写队列，父图自然停止。工具成功/错误分支封装在子 workflow。",
  "metadata": {
    "structs": [],
    "tools": [
      {
        "name": "tavily_search",
        "kind": "local",
        "input_ports": [
          {
            "name": "keyword",
            "type": "content"
          }
        ],
        "output_ports": [
          {
            "name": "results",
            "type": "content"
          }
        ]
      },
      {
        "name": "documents.query_by_name",
        "kind": "remote",
        "input_ports": [
          {
            "name": "title",
            "type": "content"
          }
        ],
        "output_ports": [
          {
            "name": "documents",
            "type": "content"
          }
        ]
      },
      {
        "name": "documents.query_by_id",
        "kind": "remote",
        "input_ports": [
          {
            "name": "doc_id",
            "type": "content"
          }
        ],
        "output_ports": [
          {
            "name": "document",
            "type": "content"
          }
        ]
      },
      {
        "name": "workspace.list_files",
        "kind": "local",
        "input_ports": [],
        "output_ports": []
      },
      {
        "name": "workspace.get_file",
        "kind": "local",
        "input_ports": [
          {
            "name": "file_id",
            "type": "content"
          }
        ],
        "output_ports": []
      },
      {
        "name": "workspace.create_file",
        "kind": "local",
        "input_ports": [],
        "output_ports": []
      },
      {
        "name": "workspace.update_file",
        "kind": "local",
        "input_ports": [],
        "output_ports": []
      },
      {
        "name": "workspace.delete_file",
        "kind": "local",
        "input_ports": [],
        "output_ports": []
      },
      {
        "name": "workspace.list_checkpoints",
        "kind": "local",
        "input_ports": [],
        "output_ports": []
      },
      {
        "name": "workspace.checkpoint_tree",
        "kind": "local",
        "input_ports": [],
        "output_ports": []
      },
      {
        "name": "workspace.get_parent_checkpoint",
        "kind": "local",
        "input_ports": [],
        "output_ports": []
      },
      {
        "name": "workspace.checkpoint_diff",
        "kind": "local",
        "input_ports": [],
        "output_ports": []
      }
    ]
  },
  "input_ports": [
    {
      "name": "messages_context",
      "type": "content"
    },
    {
      "name": "continuation_context",
      "type": "content"
    },
    {
      "name": "answer_context",
      "type": "content"
    }
  ],
  "output_ports": [],
  "nodes": [
    {
      "id": "input",
      "type": "input",
      "name": "接收本轮共用的对话和状态",
      "x": 0,
      "y": 120,
      "workflowPorts": [
        {
          "id": "workflow:messages_context",
          "name": "messages_context",
          "type": "content"
        },
        {
          "id": "workflow:continuation_context",
          "name": "continuation_context",
          "type": "content"
        },
        {
          "id": "workflow:answer_context",
          "name": "answer_context",
          "type": "content"
        }
      ]
    },
    {
      "id": "read_messages",
      "type": "context_read",
      "name": "读取截至本轮的对话记录",
      "x": 260,
      "y": 120,
      "arguments": {
        "value_type": "list-message"
      }
    },
    {
      "id": "reason_and_act",
      "type": "llm",
      "name": "分析任务：调用工具或给出答案",
      "x": 520,
      "y": 120,
      "arguments": {
        "model": "6aba33cb2d499f6a57d08bc3",
        "think": false,
        "tool_calls": true,
        "tools": [
          "tavily_search",
          "documents.query_by_name",
          "documents.query_by_id",
          "workspace.list_files",
          "workspace.get_file",
          "workspace.create_file",
          "workspace.update_file",
          "workspace.delete_file",
          "workspace.list_checkpoints",
          "workspace.checkpoint_tree",
          "workspace.get_parent_checkpoint",
          "workspace.checkpoint_diff"
        ]
      }
    },
    {
      "id": "normalize_answer",
      "type": "construct_content",
      "name": "保留本轮回答，兼容纯工具响应",
      "x": 780,
      "y": 120,
      "dataInputPorts": [
        "answer-in"
      ],
      "arguments": {
        "append_items": [
          {
            "type": "port",
            "port_id": "answer-in"
          }
        ]
      }
    },
    {
      "id": "write_answer",
      "type": "context_write",
      "name": "保存本轮回答供结束时返回",
      "x": 1040,
      "y": 120,
      "arguments": {
        "value_type": "content"
      }
    },
    {
      "id": "each_tool",
      "type": "foreach",
      "name": "逐个执行本轮模型提出的工具",
      "x": 1300,
      "y": 120,
      "arguments": {
        "item_type": "content"
      }
    },
    {
      "id": "output",
      "type": "output",
      "name": "本轮工具处理完毕，返回主循环",
      "x": 1560,
      "y": 120,
      "workflowPorts": []
    },
    {
      "id": "dispatch",
      "type": "workflow",
      "name": "执行当前工具并取得成功或错误观察",
      "x": 1300,
      "y": 480,
      "input_ports": [
        {
          "name": "tool_call_json",
          "type": "content"
        }
      ],
      "output_ports": [
        {
          "name": "observation",
          "type": "content"
        }
      ],
      "arguments": {
        "workflow_name": "react_tool_dispatch.flow"
      }
    },
    {
      "id": "read_before_append",
      "type": "context_read",
      "name": "读取对话以追加当前工具观察",
      "x": 1560,
      "y": 480,
      "arguments": {
        "value_type": "list-message"
      }
    },
    {
      "id": "observation_message",
      "type": "construct_message",
      "name": "把工具观察整理为反馈消息",
      "x": 1820,
      "y": 480,
      "arguments": {
        "role": "user",
        "role_source": "fixed"
      }
    },
    {
      "id": "append_observation",
      "type": "list_append",
      "name": "把当前工具观察追加到对话末尾",
      "x": 2080,
      "y": 480,
      "arguments": {
        "item_type": "message",
        "position": "end"
      }
    },
    {
      "id": "write_messages",
      "type": "context_write",
      "name": "保存对话，供下一轮分析使用",
      "x": 2340,
      "y": 480,
      "arguments": {
        "value_type": "list-message"
      }
    },
    {
      "id": "continue_token",
      "type": "construct_content",
      "name": "标记还需要一轮分析",
      "x": 2600,
      "y": 480,
      "dataInputPorts": [],
      "arguments": {
        "append_items": [
          {
            "type": "fixed",
            "value": "continue"
          }
        ]
      }
    },
    {
      "id": "next_round_queue",
      "type": "construct_list",
      "name": "生成仅含一个继续标记的列表",
      "x": 2860,
      "y": 480,
      "dataInputPorts": [
        "content-in-0"
      ],
      "arguments": {
        "item_type": "content",
        "initial_value_count": 1
      }
    },
    {
      "id": "schedule_next_round",
      "type": "context_write",
      "name": "覆盖继续队列，确保只追加一轮",
      "x": 3120,
      "y": 480,
      "arguments": {
        "value_type": "list-content"
      }
    }
  ],
  "connections": [
    {
      "fromId": "input",
      "fromPortId": "control-out",
      "toId": "read_messages",
      "toPortId": "control-in",
      "type": "control",
      "id": "react_round_edge_1"
    },
    {
      "fromId": "read_messages",
      "fromPortId": "control-out",
      "toId": "reason_and_act",
      "toPortId": "control-in",
      "type": "control",
      "id": "react_round_edge_2"
    },
    {
      "fromId": "reason_and_act",
      "fromPortId": "control-out",
      "toId": "normalize_answer",
      "toPortId": "control-in",
      "type": "control",
      "id": "react_round_edge_3"
    },
    {
      "fromId": "normalize_answer",
      "fromPortId": "control-out",
      "toId": "write_answer",
      "toPortId": "control-in",
      "type": "control",
      "id": "react_round_edge_4"
    },
    {
      "fromId": "write_answer",
      "fromPortId": "control-out",
      "toId": "each_tool",
      "toPortId": "control-in",
      "type": "control",
      "id": "react_round_edge_5"
    },
    {
      "fromId": "each_tool",
      "fromPortId": "control-out",
      "toId": "output",
      "toPortId": "control-in",
      "type": "control",
      "id": "react_round_edge_6"
    },
    {
      "fromId": "each_tool",
      "fromPortId": "loop-out",
      "toId": "dispatch",
      "toPortId": "control-in",
      "type": "control",
      "id": "react_round_edge_7"
    },
    {
      "fromId": "dispatch",
      "fromPortId": "control-out",
      "toId": "read_before_append",
      "toPortId": "control-in",
      "type": "control",
      "id": "react_round_edge_8"
    },
    {
      "fromId": "read_before_append",
      "fromPortId": "control-out",
      "toId": "observation_message",
      "toPortId": "control-in",
      "type": "control",
      "id": "react_round_edge_9"
    },
    {
      "fromId": "observation_message",
      "fromPortId": "control-out",
      "toId": "append_observation",
      "toPortId": "control-in",
      "type": "control",
      "id": "react_round_edge_10"
    },
    {
      "fromId": "append_observation",
      "fromPortId": "control-out",
      "toId": "write_messages",
      "toPortId": "control-in",
      "type": "control",
      "id": "react_round_edge_11"
    },
    {
      "fromId": "write_messages",
      "fromPortId": "control-out",
      "toId": "continue_token",
      "toPortId": "control-in",
      "type": "control",
      "id": "react_round_edge_12"
    },
    {
      "fromId": "continue_token",
      "fromPortId": "control-out",
      "toId": "next_round_queue",
      "toPortId": "control-in",
      "type": "control",
      "id": "react_round_edge_13"
    },
    {
      "fromId": "next_round_queue",
      "fromPortId": "control-out",
      "toId": "schedule_next_round",
      "toPortId": "control-in",
      "type": "control",
      "id": "react_round_edge_14"
    },
    {
      "fromId": "schedule_next_round",
      "fromPortId": "control-out",
      "toId": "each_tool",
      "toPortId": "loop-in",
      "type": "control",
      "id": "react_round_edge_15"
    },
    {
      "fromId": "input",
      "fromPortId": "workflow:messages_context",
      "toId": "read_messages",
      "toPortId": "context-id",
      "type": "content",
      "id": "react_round_edge_16"
    },
    {
      "fromId": "read_messages",
      "fromPortId": "value-out",
      "toId": "reason_and_act",
      "toPortId": "messages-in",
      "type": "list-message",
      "id": "react_round_edge_17"
    },
    {
      "fromId": "reason_and_act",
      "fromPortId": "output",
      "toId": "normalize_answer",
      "toPortId": "answer-in",
      "type": "content",
      "id": "react_round_edge_18"
    },
    {
      "fromId": "input",
      "fromPortId": "workflow:answer_context",
      "toId": "write_answer",
      "toPortId": "context-id",
      "type": "content",
      "id": "react_round_edge_19"
    },
    {
      "fromId": "normalize_answer",
      "fromPortId": "content-out",
      "toId": "write_answer",
      "toPortId": "value-in",
      "type": "content",
      "id": "react_round_edge_20"
    },
    {
      "fromId": "reason_and_act",
      "fromPortId": "tool_calls",
      "toId": "each_tool",
      "toPortId": "list-in",
      "type": "list-content",
      "id": "react_round_edge_21"
    },
    {
      "fromId": "each_tool",
      "fromPortId": "item-out",
      "toId": "dispatch",
      "toPortId": "workflow:tool_call_json",
      "type": "content",
      "id": "react_round_edge_22"
    },
    {
      "fromId": "input",
      "fromPortId": "workflow:messages_context",
      "toId": "read_before_append",
      "toPortId": "context-id",
      "type": "content",
      "id": "react_round_edge_23"
    },
    {
      "fromId": "dispatch",
      "fromPortId": "workflow:observation",
      "toId": "observation_message",
      "toPortId": "content-in",
      "type": "content",
      "id": "react_round_edge_24"
    },
    {
      "fromId": "read_before_append",
      "fromPortId": "value-out",
      "toId": "append_observation",
      "toPortId": "list-in",
      "type": "list-message",
      "id": "react_round_edge_25"
    },
    {
      "fromId": "observation_message",
      "fromPortId": "message-out",
      "toId": "append_observation",
      "toPortId": "item-in",
      "type": "message",
      "id": "react_round_edge_26"
    },
    {
      "fromId": "input",
      "fromPortId": "workflow:messages_context",
      "toId": "write_messages",
      "toPortId": "context-id",
      "type": "content",
      "id": "react_round_edge_27"
    },
    {
      "fromId": "append_observation",
      "fromPortId": "list-out",
      "toId": "write_messages",
      "toPortId": "value-in",
      "type": "list-message",
      "id": "react_round_edge_28"
    },
    {
      "fromId": "continue_token",
      "fromPortId": "content-out",
      "toId": "next_round_queue",
      "toPortId": "content-in-0",
      "type": "content",
      "id": "react_round_edge_29"
    },
    {
      "fromId": "next_round_queue",
      "fromPortId": "list-out",
      "toId": "schedule_next_round",
      "toPortId": "value-in",
      "type": "list-content",
      "id": "react_round_edge_30"
    },
    {
      "fromId": "input",
      "fromPortId": "workflow:continuation_context",
      "toId": "schedule_next_round",
      "toPortId": "context-id",
      "type": "content",
      "id": "react_round_edge_31"
    }
  ],
  "workflow_nodes": [
    {
      "name": "react_tool_dispatch.flow",
      "input_ports": [
        {
          "name": "tool_call_json",
          "type": "content"
        }
      ],
      "output_ports": [
        {
          "name": "observation",
          "type": "content"
        }
      ]
    }
  ],
  "remote_tools": []
}
